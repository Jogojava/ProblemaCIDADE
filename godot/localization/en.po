msgstr " · Estimate in 6 months: R$ %.0f"

msgid "Reputação: %.1f%% · Educação: %.0f · Saúde: %.0f · Segurança: %.0f\nDesemprego: %.1f%% · Fome: %.1f%%"
msgstr "Reputation: %.1f%% · Education: %.0f · Health: %.0f · Security: %.0f\nUnemployment: %.1f%% · Hunger: %.1f%%"

msgid "Dados insuficientes: são necessárias 12 observações mensais."
msgstr "Insufficient data: 12 monthly observations are required."

msgid "12 observações · linha contínua: histórico · tracejada: estimativa de 6 meses"
msgstr "12 observations · solid line: history · dashed: 6-month estimate"

msgid "Estimativa por tendência linear; não é uma garantia. Reage às decisões futuras."
msgstr "Linear trend estimate; not a guarantee. Future decisions affect outcomes."

