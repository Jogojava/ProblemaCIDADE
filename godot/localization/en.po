msgstr "This area has already reached 100 points."

msgid "Construção indisponível."
msgstr "Construction unavailable."

msgid "Saldo insuficiente para a obra."
msgstr "Insufficient funds for construction."

msgid "Conclua uma das três obras em andamento."
msgstr "Complete one of the three current projects first."

msgid "A cidade já possui 30 instalações. Invista nos serviços existentes."
msgstr "The city already has 30 facilities. Invest in existing services."

msgid "Já existe uma obra em andamento nesta área."
msgstr "Construction is already in progress in this area."

msgid "Investimento aplicado em %s."
msgstr "Investment applied to %s."

msgid "Obra iniciada: %s. Conclusão em 20 dias."
msgstr "Construction started: %s. Completion in 20 days."

msgid "Obra concluída: %s. Serviços e reputação atualizados."
msgstr "Construction complete: %s. Services and reputation updated."

msgid "Reputação e finanças"
msgstr "Reputation and finances"

msgid "Mês %d/96 · %d respostas corretas em %d problemas · %d expirados."
msgstr "Month %d/96 · %d correct answers out of %d problems · %d expired."

